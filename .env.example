# Copy to .env and fill in. NEVER commit .env.

# LLM (free tiers). Gemini is primary, Groq is the fallback.
# Comma-separated lists: each model is tried in order (Gemini free tier is ~20 req/day PER model).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# GitHub: fine-grained token scoped ONLY to your test repo.
# Read-only use (public repos) works without a token, but rate limit is 60 req/hour.
# Write tools (create_issue, comment_on_pr) need Issues + Pull requests: read/write.
GITHUB_TOKEN=

# Qdrant: leave empty to use embedded local storage at ./data/qdrant
QDRANT_URL=

# Agent
MAX_ITERATIONS=8
# Public demo: approved write actions are simulated instead of sent to GitHub
DRY_RUN_WRITES=false
DATA_DIR=./data

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=devagent
